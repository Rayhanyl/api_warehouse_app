# ============================================================================
# TEMPLATE: BACKEND LOKAL -> DATABASE SERVER DEVELOPMENT (.env.development.example)
#
# Salin menjadi `.env.development` (TIDAK di-commit), lalu jalankan backend dengan:
#   PowerShell : $env:ENV_FILE=".env.development"; uvicorn app.main:app --reload
#   Bash       : ENV_FILE=.env.development uvicorn app.main:app --reload
#
# Port PostgreSQL di server hanya terbuka di 127.0.0.1 (tidak ke internet), jadi
# akses melalui SSH tunnel dari PC Anda, tinggalkan terminal ini terbuka:
#   ssh -N -L 15432:127.0.0.1:5432 <user>@<host-server-development>
# Karena itu host database di bawah adalah `localhost` dengan port tunnel 15432.
#
# JANGAN pernah mengarahkan berkas ini ke database production.
# ============================================================================

APP_ENV=development

JWT_SECRET=ganti-dengan-string-acak-minimal-32-byte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
API_PORT=8000
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Database di server development (lewat SSH tunnel). Nama database development
# sengaja berbeda dari production.
DATABASE_URL=postgresql://wms_app:<password_wms_app_dev>@localhost:15432/wms_development
MIGRATION_DATABASE_URL=postgresql://wms_owner:<password_wms_owner_dev>@localhost:15432/wms_development
# Pytest tetap harus mengarah ke database bernama wms_test.
TEST_DATABASE_URL=postgresql://wms_owner:<password_wms_owner_dev>@localhost:15432/wms_test
