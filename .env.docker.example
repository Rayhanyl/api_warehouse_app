# ============================================================================
# TEMPLATE: DOCKER COMPOSE LOKAL (.env.docker.example)
#
# Salin menjadi `.env.docker` (TIDAK di-commit). Berkas ini satu-satunya sumber
# konfigurasi container `postgres` dan `api` pada docker-compose.yml, jadi isi
# SEMUA variabel di bawah (compose menolak berjalan bila berkas tidak ada).
#
#   Copy-Item .env.docker.example .env.docker
#   docker compose up --build
#
# Di dalam container, host database adalah nama service `postgres` (bukan localhost).
# Untuk memakai PostgreSQL di PC (host.docker.internal), ganti host pada tiga URL.
# Khusus pengembangan lokal; JANGAN dipakai di server.
# ============================================================================

APP_ENV=local

# --- Container postgres ---
POSTGRES_USER=wms_owner
POSTGRES_PASSWORD=<password_wms_owner>
POSTGRES_DB=wms
POSTGRES_PORT=5432

# --- Container api ---
# Password wms_owner pada URL harus sama dengan POSTGRES_PASSWORD (di-URL-encode bila memuat
# karakter khusus). Role `wms_app` dibuat oleh db/init/001_create_app_role.sql dengan password
# tetap khusus-dev `wms_app_pass` (variabel lingkungan tidak dibaca oleh skrip SQL tersebut).
DATABASE_URL=postgresql://wms_app:wms_app_pass@postgres:5432/wms
MIGRATION_DATABASE_URL=postgresql://wms_owner:<password_wms_owner>@postgres:5432/wms
TEST_DATABASE_URL=postgresql://wms_owner:<password_wms_owner>@postgres:5432/wms_test

JWT_SECRET=ganti-dengan-string-acak-minimal-32-byte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
API_PORT=8000
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# --- Notifikasi Telegram (opsional) ---
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=<ganti-dengan-token-bot-dari-botfather>
TELEGRAM_CHAT_ID=<ganti-dengan-chat-id-tujuan>
TELEGRAM_THREAD_ID=
TELEGRAM_TIMEOUT_SECONDS=5.0
TELEGRAM_COOLDOWN_SECONDS=60
DOCKER_MONITOR_FILTERS=wms
