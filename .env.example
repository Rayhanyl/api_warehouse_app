# ============================================================================
# ACUAN KONFIGURASI LINGKUNGAN (.env.example)
# Salin ke `.env` (untuk lokal / DBeaver) atau `.env.docker` (untuk Docker)
# ============================================================================

# --- 1. KONFIGURASI APLIKASI & JWT ---
JWT_SECRET=ganti-dengan-string-acak-minimal-32-byte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
API_PORT=8000
FRONTEND_ORIGINS=["http://localhost:5173"]

# --- 2. MODE A: KONEKSI LANGSUNG LOKAL & DBEAVER (Host: localhost) ---
# Gunakan host `localhost` saat menjalankan `python -m db.migrate` atau `uvicorn` dari terminal lokal,
# serta saat menghubungkan DBeaver ke PostgreSQL (baik PostgreSQL lokal maupun container Docker).
DATABASE_URL=postgresql://wms_app:<password_wms_app>@localhost:5432/wms
MIGRATION_DATABASE_URL=postgresql://wms_owner:<password_wms_owner>@localhost:5432/wms
TEST_DATABASE_URL=postgresql://wms_owner:<password_wms_owner>@localhost:5432/wms_test

# --- 3. MODE B: KONEKSI DARI CONTAINER DOCKER (.env.docker) ---
# Opsi B1 - API di Docker terhubung ke container `postgres` di docker-compose (Host: postgres):
# DATABASE_URL=postgresql://wms_app:<password_wms_app>@postgres:5432/wms
# MIGRATION_DATABASE_URL=postgresql://wms_owner:<password_wms_owner>@postgres:5432/wms
# TEST_DATABASE_URL=postgresql://wms_owner:<password_wms_owner>@postgres:5432/wms_test
#
# Opsi B2 - API di Docker terhubung ke PostgreSQL lokal yang sudah ada di PC/DBeaver (Host: host.docker.internal):
# DATABASE_URL=postgresql://wms_app:<password_wms_app>@host.docker.internal:5432/wms
# MIGRATION_DATABASE_URL=postgresql://wms_owner:<password_wms_owner>@host.docker.internal:5432/wms
# TEST_DATABASE_URL=postgresql://wms_owner:<password_wms_owner>@host.docker.internal:5432/wms_test
