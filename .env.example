# ============================================================================
# TEMPLATE KONFIGURASI BACKEND (.env.example)
#
# Salin menjadi `.env` untuk menjalankan backend langsung di PC (uvicorn / pytest
# / python -m db.migrate) dengan PostgreSQL lokal. `.env` TIDAK boleh di-commit.
#
# Pemilihan berkas env (lihat docs/core/environment-setup-guide.md):
#   - Default           : `.env`, lalu `.env.local` (menimpa `.env` bila ada).
#   - Berkas lain       : set variabel OS ENV_FILE, mis. ENV_FILE=.env.development
#   - Variabel OS selalu menang atas isi berkas.
# Template lain:
#   - .env.development.example : backend lokal -> database server development
#   - .env.docker.example      : Docker Compose lokal
# ============================================================================

# --- 1. IDENTITAS LINGKUNGAN ---
# local | development | staging | production
APP_ENV=local

# --- 2. APLIKASI, JWT & SESI ---
# Wajib minimal 32 karakter. Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-byte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
API_PORT=8000

# Daftar origin frontend yang diizinkan CORS (format JSON array).
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Cookie refresh token. Lokal (HTTP, dengan Vite proxy): Secure=False, SameSite=lax.
# Production (HTTPS lintas domain): COOKIE_SECURE=True dan COOKIE_SAMESITE=none.
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# --- 3. DATABASE LOKAL (host: localhost) ---
# Gunakan password yang diganti sendiri. Karakter khusus pada password harus di-URL-encode
# (mis. `@` -> %40, `#` -> %23).
DATABASE_URL=postgresql://wms_app:<password_wms_app>@localhost:5432/wms
MIGRATION_DATABASE_URL=postgresql://wms_owner:<password_wms_owner>@localhost:5432/wms
# Pytest hanya berjalan jika nama database = wms_test (guard di tests/conftest.py).
TEST_DATABASE_URL=postgresql://wms_owner:<password_wms_owner>@localhost:5432/wms_test
